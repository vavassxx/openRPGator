+        for (String[] entry : loadSavedServers()) {
+            if (entry[0].equalsIgnoreCase(host) && entry[1].equals(port)) continue;
+            if (next.size() >= 8) break;
+            next.add(entry);
+        }
+        saveSavedServers(next);
+    }
